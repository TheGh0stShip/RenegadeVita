+#if defined(RENEGADE_VITA_PORT)
+// ARMv7 VFPv3 has no VRINTM/VRINTP, so floorf/ceilf were out-of-line newlib
+// calls. These are the newlib sf_floor.c/sf_ceil.c bit algorithms inlined:
+// integer-only except x+x for Inf/NaN (same VFP op as newlib), so results
+// are bit-identical for every input under any FPSCR FZ/DN/rounding mode.
+WWINLINE float WWMath::Floor(float x)
+{
+	uint32_t i0 = 0;
+	memcpy(&i0, &x, sizeof(i0));
+	const int32_t j0 = static_cast<int32_t>((i0 >> 23) & 0xFFU) - 0x7F;
+	if (j0 < 0) {
+		if (static_cast<int32_t>(i0) >= 0) i0 = 0U;
+		else if ((i0 & 0x7FFFFFFFU) != 0U) i0 = 0xBF800000U;
+	} else if (j0 < 23) {
+		const uint32_t mask = 0x007FFFFFU >> j0;
+		if ((i0 & mask) == 0U) return x;
+		if (static_cast<int32_t>(i0) < 0) i0 += 0x00800000U >> j0;
+		i0 &= ~mask;
+	} else {
+		return (j0 == 0x80) ? x + x : x;
+	}
+	memcpy(&x, &i0, sizeof(x));
+	return x;
+}
+
+WWINLINE float WWMath::Ceil(float x)
+{
+	uint32_t i0 = 0;
+	memcpy(&i0, &x, sizeof(i0));
+	const int32_t j0 = static_cast<int32_t>((i0 >> 23) & 0xFFU) - 0x7F;
+	if (j0 < 0) {
+		if (static_cast<int32_t>(i0) < 0) i0 = 0x80000000U;
+		else if (i0 != 0U) i0 = 0x3F800000U;
+	} else if (j0 < 23) {
+		const uint32_t mask = 0x007FFFFFU >> j0;
+		if ((i0 & mask) == 0U) return x;
+		if (static_cast<int32_t>(i0) > 0) i0 += 0x00800000U >> j0;
+		i0 &= ~mask;
+	} else {
+		return (j0 == 0x80) ? x + x : x;
+	}
+	memcpy(&x, &i0, sizeof(x));
+	return x;
+}
+#endif
