+
+uint32_t vglRenegadeGetFfpStats(uint32_t *out, uint32_t max_count) {
+	renegade_ffp_stats[RENEGADE_FFP_STAT_VERT_CACHE_SIZE] = vert_shader_cache_size;
+	renegade_ffp_stats[RENEGADE_FFP_STAT_FRAG_CACHE_SIZE] = frag_shader_cache_size;
+	uint32_t count = max_count < RENEGADE_FFP_STAT_COUNT ? max_count : RENEGADE_FFP_STAT_COUNT;
+	for (uint32_t i = 0; i < count; i++)
+		out[i] = renegade_ffp_stats[i];
+	return count;
+}
+
+static void renegade_ffp_count_build(int stat, uint32_t start_us) {
+	uint32_t elapsed = sceKernelGetProcessTimeLow() - start_us;
+	renegade_ffp_stats[stat]++;
+	if (stat == RENEGADE_FFP_STAT_VERT_COMPILES || stat == RENEGADE_FFP_STAT_FRAG_COMPILES) {
+		renegade_ffp_stats[RENEGADE_FFP_STAT_COMPILE_US] += elapsed;
+		if (elapsed > renegade_ffp_stats[RENEGADE_FFP_STAT_COMPILE_MAX_US])
+			renegade_ffp_stats[RENEGADE_FFP_STAT_COMPILE_MAX_US] = elapsed;
+	} else {
+		renegade_ffp_stats[RENEGADE_FFP_STAT_DISK_US] += elapsed;
+	}
+}
