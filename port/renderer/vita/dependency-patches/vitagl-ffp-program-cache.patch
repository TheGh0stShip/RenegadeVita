+// Renegade platform extension: export the FFP program keys resident in the
+// RAM cache (insertion order). Fragment keys are {mask, combiner low, high}.
+void vglRenegadeGetFfpKeys(uint32_t *vert, int max_vert, int *n_vert, uint32_t *frag, int max_frag, int *n_frag) {
+	int nv = 0, nf = 0;
+	for (int i = 0; i < vert_shader_cache_size && nv < max_vert; i++)
+		vert[nv++] = vert_shader_cache[i].mask.raw;
+	for (int i = 0; i < frag_shader_cache_size && nf < max_frag; i++) {
+		frag[nf * 3 + 0] = frag_shader_cache[i].mask.raw;
+		frag[nf * 3 + 1] = (uint32_t)frag_shader_cache[i].cmb_mask.raw;
+		frag[nf * 3 + 2] = (uint32_t)(frag_shader_cache[i].cmb_mask.raw >> 32);
+		nf++;
+	}
+	*n_vert = nv;
+	*n_frag = nf;
+}
+
+// Renegade platform extension: loading-time pre-warm. Each key that is not
+// yet resident and whose GXP is already in the persistent cache is loaded,
+// registered and inserted exactly as reload_ffp_shaders would on first use.
+// Keys without a cached GXP are skipped (first use compiles them as before),
+// the RAM cache never wraps here, and the active program state is restored.
+void vglRenegadePrewarmFfpPrograms(const uint32_t *vert, int n_vert, const uint32_t *frag, int n_frag, int *vert_loaded, int *frag_loaded) {
+	SceGxmProgram *saved_vertex_program = ffp_vertex_program;
+	int *saved_vertex_params = ffp_vertex_params;
+	int *saved_vertex_attribs = ffp_vertex_attribs;
+	SceGxmProgram *saved_fragment_program = ffp_fragment_program;
+	int *saved_fragment_params = ffp_fragment_params;
+	char fname[256];
+	int nv = 0, nf = 0;
+	for (int k = 0; k < n_vert && vert_shader_cache_size < SHADER_CACHE_SIZE; k++) {
+		uint32_t key = vert[k];
+		int resident = (key & VERTEX_SHADER_MASK) != key;
+		for (int i = 0; i < vert_shader_cache_size && !resident; i++)
+			resident = vert_shader_cache[i].mask.raw == key;
+		if (resident)
+			continue;
+		snprintf(fname, sizeof(fname), "%s/v/%08X-%d.gxp", vgl_renegade_ffp_cache_path, key, WVP_ON_GPU);
+		uint32_t start = sceKernelGetProcessTimeLow();
+		SceGxmProgram *prog = renegade_load_cached_ffp_program(fname);
+		SceGxmShaderPatcherId id;
+		if (!prog)
+			continue;
+		if (sceGxmShaderPatcherRegisterProgram(gxm_shader_patcher, prog, &id) < 0) {
+			vgl_free(prog);
+			continue;
+		}
+		renegade_ffp_count_build(RENEGADE_FFP_STAT_PREWARM_VERT, start);
+		vert_shader_cache_idx = (vert_shader_cache_idx + 1) % SHADER_CACHE_SIZE;
+		vert_shader_cache_size++;
+		cached_vertex_shader *entry = &vert_shader_cache[vert_shader_cache_idx];
+		entry->mask.raw = key;
+		entry->prog = prog;
+		entry->id = id;
+		entry->unif_buf_size = sceGxmProgramGetDefaultUniformBufferSize(prog);
+		entry->unif_buf = vglMalloc(entry->unif_buf_size);
+		renegade_ffp_stats[RENEGADE_FFP_STAT_PREWARM_BYTES] += sceGxmProgramGetSize(prog) + entry->unif_buf_size;
+		ffp_vertex_program = prog;
+		reload_vertex_uniforms_and_attributes(entry->vert_unifs, entry->attributes);
+		nv++;
+	}
+	for (int k = 0; k < n_frag && frag_shader_cache_size < SHADER_CACHE_SIZE; k++) {
+		uint32_t key = frag[k * 3 + 0];
+		uint64_t cmb = (uint64_t)frag[k * 3 + 1] | ((uint64_t)frag[k * 3 + 2] << 32);
+		int resident = (key & FRAGMENT_SHADER_MASK) != key;
+		for (int i = 0; i < frag_shader_cache_size && !resident; i++)
+			resident = frag_shader_cache[i].mask.raw == key && frag_shader_cache[i].cmb_mask.raw == cmb;
+		if (resident)
+			continue;
+		snprintf(fname, sizeof(fname), "%s/f/%08X-%016llX.gxp", vgl_renegade_ffp_cache_path, key, cmb);
+		uint32_t start = sceKernelGetProcessTimeLow();
+		SceGxmProgram *prog = renegade_load_cached_ffp_program(fname);
+		SceGxmShaderPatcherId id;
+		if (!prog)
+			continue;
+		if (sceGxmShaderPatcherRegisterProgram(gxm_shader_patcher, prog, &id) < 0) {
+			vgl_free(prog);
+			continue;
+		}
+		renegade_ffp_count_build(RENEGADE_FFP_STAT_PREWARM_FRAG, start);
+		frag_shader_cache_idx = (frag_shader_cache_idx + 1) % SHADER_CACHE_SIZE;
+		frag_shader_cache_size++;
+		cached_fragment_shader *entry = &frag_shader_cache[frag_shader_cache_idx];
+		entry->mask.raw = key;
+		entry->cmb_mask.raw = cmb;
+		entry->prog = prog;
+		entry->id = id;
+		entry->unif_buf_size = sceGxmProgramGetDefaultUniformBufferSize(prog);
+		entry->unif_buf = entry->unif_buf_size ? vglMalloc(entry->unif_buf_size) : NULL;
+		renegade_ffp_stats[RENEGADE_FFP_STAT_PREWARM_BYTES] += sceGxmProgramGetSize(prog) + entry->unif_buf_size;
+		ffp_fragment_program = prog;
+		reload_fragment_uniforms(entry->frag_unifs);
+		nf++;
+	}
+	ffp_vertex_program = saved_vertex_program;
+	ffp_vertex_params = saved_vertex_params;
+	ffp_vertex_attribs = saved_vertex_attribs;
+	ffp_fragment_program = saved_fragment_program;
+	ffp_fragment_params = saved_fragment_params;
+	*vert_loaded = nv;
+	*frag_loaded = nf;
+}
