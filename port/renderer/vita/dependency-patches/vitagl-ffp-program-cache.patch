+// Reads one cached GXP. A missing, empty, oversized, short-read or
+// structurally invalid file returns NULL so the caller recompiles and
+// rewrites it, instead of registering a truncated program.
+static SceGxmProgram *renegade_load_cached_ffp_program(const char *fname) {
+	SceUID f = sceIoOpen(fname, SCE_O_RDONLY, 0777);
+	if (f < 0)
+		return NULL;
+	SceOff end = sceIoLseek(f, 0, SCE_SEEK_END);
+	sceIoLseek(f, 0, SCE_SEEK_SET);
+	SceGxmProgram *prog = NULL;
+	if (end > 0 && end <= RENEGADE_FFP_MAX_GXP_BYTES) {
+		uint32_t size = (uint32_t)end;
+		prog = (SceGxmProgram *)vglMalloc(size);
+		if (prog && (sceIoRead(f, prog, size) != (int)size || sceGxmProgramCheck(prog) != 0 || sceGxmProgramGetSize(prog) > size)) {
+			vgl_free(prog);
+			prog = NULL;
+		}
+	}
+	sceIoClose(f);
+	if (!prog)
+		renegade_ffp_stats[RENEGADE_FFP_STAT_DISK_REJECTS]++;
+	return prog;
+}
