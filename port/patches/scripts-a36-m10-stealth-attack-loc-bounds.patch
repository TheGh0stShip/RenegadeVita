 	{
+		// Vita bounds: loc stays 100 until the first GOTO_LOC timer picks a node.
+		if (loc < 0 || loc > 12)
+		{
+			return;
+		}
 		ActionParamsStruct params;

 		params.Set_Basic( this, INNATE_PRIORITY_ENEMY_SEEN +5, 10 );
