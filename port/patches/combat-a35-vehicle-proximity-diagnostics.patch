 void	VehicleGameObj::Update_Transitions( void )
 {
+#if defined(__vita__)
+	const uint64_t update_start_us = sceKernelGetProcessTimeWide();
+#endif
 	Matrix3D tm = Get_Transform();
 
 	// Update all transitions
 	for ( int i = 0; i < TransitionInstances.Count(); i++ ) {
 		TransitionInstances[i]->Set_Parent_Transform( tm );
 	}
+#if defined(__vita__)
+	const uint64_t update_elapsed_us =
+		sceKernelGetProcessTimeWide() - update_start_us;
+	const float star_distance = Vita_Distance_To_Star(this);
+	const bool slow_update = update_elapsed_us >= 3000U;
+	const bool near_star = star_distance >= 0.0f && star_distance <= 18.0f &&
+		TransitionInstances.Count() > 0;
+	if (g_vita_vehicle_transition_update_logs < 160U &&
+		(slow_update || near_star)) {
+		++g_vita_vehicle_transition_update_logs;
+		Vector3 position;
+		Get_Position(&position);
+		A30_Vita_Log("A3.5 vehicle: update transitions obj=%p type=%d/%s instances=%d seats=%d occupied=%d enabled=%d elapsed_us=%llu slow=%d near_star=%d pos=(%.3f,%.3f,%.3f) star_dist=%.3f phys=%p vehphys=%p model=%p\n",
+			static_cast<void *>(this), static_cast<int>(Get_Definition().Type),
+			VITA_VEHICLE_TYPE_NAME(Get_Definition()), TransitionInstances.Count(),
+			Get_Definition().NumSeats, OccupiedSeats, TransitionsEnabled ? 1 : 0,
+			static_cast<unsigned long long>(update_elapsed_us),
+			slow_update ? 1 : 0, near_star ? 1 : 0,
+			position.X, position.Y, position.Z, star_distance,
+			static_cast<void *>(Peek_Physical_Object()),
+			static_cast<void *>(Peek_Vehicle_Phys()),
+			static_cast<void *>(Peek_Model()));
+	}
+#endif
 }
 
 
