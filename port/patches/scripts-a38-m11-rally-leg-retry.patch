+	int rallyLegAction;
+	int rallyLegWaypath;
+	int rallyLegStart;
+	int rallyLegEnd;
+	int rallyLegRetries;
+
+	enum { VITA_RALLY_LEG_MAX_RETRIES = 3 };
 
 	REGISTER_VARIABLES()
