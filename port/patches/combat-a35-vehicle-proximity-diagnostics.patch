+float Vita_Distance_To_Star(VehicleGameObj *vehicle)
+{
+	if (vehicle == NULL || COMBAT_STAR == NULL) return -1.0f;
+	Vector3 vehicle_position;
+	Vector3 star_position;
+	vehicle->Get_Position(&vehicle_position);
+	COMBAT_STAR->Get_Position(&star_position);
+	return (vehicle_position - star_position).Length();
+}
