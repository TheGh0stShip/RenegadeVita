M05_Dead6_Help save/load robustness. mission_failed_text is set in Entered()
and consumed in Action_Complete() to send the 501/502/503 failure report to
controller 100001, but was not saved. Register it with the unused id 4 and zero
it in Created(); 0 matches no case, so original behaviour is unchanged.

--- a/Mission05.cpp
+++ b/Mission05.cpp
@@ -6756,6 +6756,8 @@
 		SAVE_VARIABLE( already_entered, 1 );
 		SAVE_VARIABLE( deadeye_freed, 2 );
 		SAVE_VARIABLE( message_id, 3 );
+		// Vita save/load: set in Entered(), consumed in Action_Complete().
+		SAVE_VARIABLE( mission_failed_text, 4 );
 	}
 
 	void Created (GameObject * obj)
@@ -6763,6 +6765,7 @@
 		already_entered = false;
 		message_id = Get_Int_Parameter("Message_ID");
 		deadeye_freed = false;
+		mission_failed_text = 0;
 		
 	}
 
