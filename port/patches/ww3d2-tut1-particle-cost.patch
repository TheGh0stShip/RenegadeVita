+// particle-cost-v1 (RVPE1), see renegade_vita_particle_cost.h. The mode is
+// read once, normally while the first emitter loads.
+static unsigned int _ParticleCostMode = ~0U;
+
+struct ParticleCostCounters
+{
+	bool started;
+	unsigned int window_start_frame;
+	unsigned int renders;
+	unsigned int visual_updates;
+	unsigned int evaluated;
+	unsigned int skipped;
+	unsigned int drawn;
+	unsigned int empty;
+	unsigned int stale_lowest_lod;
+	unsigned int corrected;
+	unsigned int combine_saved;
+};
+static ParticleCostCounters _ParticleCost;
+
+static unsigned int Particle_Cost_Mode(void)
+{
+	if (_ParticleCostMode == ~0U) {
+		_ParticleCostMode = RenegadeVitaParticleCost::Read_Mode();
+#if defined(__vita__)
+		A30_Vita_Log("A3.6 particle-cost: version=1 mode=%u exact_decimation=%u drawn_visual_state=%u telemetry=%u window_frames=%u\n",
+			_ParticleCostMode,
+			(_ParticleCostMode & RenegadeVitaParticleCost::EXACT_DECIMATION) ? 1U : 0U,
+			(_ParticleCostMode & RenegadeVitaParticleCost::DRAWN_VISUAL_STATE) ? 1U : 0U,
+			(_ParticleCostMode & RenegadeVitaParticleCost::TELEMETRY) ? 1U : 0U,
+			(unsigned int)RenegadeVitaParticleCost::TELEMETRY_WINDOW_FRAMES);
+#endif
+	}
+	return _ParticleCostMode;
+}
+
+static bool Particle_Cost_Telemetry(void)
+{
+	return (Particle_Cost_Mode() & RenegadeVitaParticleCost::TELEMETRY) != 0U;
+}
+
+static void Particle_Cost_Telemetry_Tick(void)
+{
+	const unsigned int frame = WW3D::Get_Frame_Count();
+	if (!_ParticleCost.started) {
+		memset(&_ParticleCost, 0, sizeof(_ParticleCost));
+		_ParticleCost.started = true;
+		_ParticleCost.window_start_frame = frame;
+		return;
+	}
+	const unsigned int frames = frame - _ParticleCost.window_start_frame;
+	if (frames < (unsigned int)RenegadeVitaParticleCost::TELEMETRY_WINDOW_FRAMES) {
+		return;
+	}
+#if defined(__vita__)
+	A30_Vita_Log("A3.6 particle-cost: frames=%u renders=%u visual=%u evaluated=%u skipped=%u drawn=%u empty=%u stale_lowest_lod=%u corrected=%u combine_saved=%u mode=%u acceptance=unassessed\n",
+		frames, _ParticleCost.renders, _ParticleCost.visual_updates, _ParticleCost.evaluated,
+		_ParticleCost.skipped, _ParticleCost.drawn, _ParticleCost.empty,
+		_ParticleCost.stale_lowest_lod, _ParticleCost.corrected, _ParticleCost.combine_saved,
+		Particle_Cost_Mode());
+#endif
+	memset(&_ParticleCost, 0, sizeof(_ParticleCost));
+	_ParticleCost.started = true;
+	_ParticleCost.window_start_frame = frame;
+}
