+		int unit_id = Get_Int_Parameter("Unit_ID");
+		if(!loss_reported && unit_id != 0)
+		{
+			loss_reported = true;
+			Commands->Send_Custom_Event(obj, Commands->Find_Object(100112), M05_TOWNSQUARE_REINFORCE, unit_id, 1.0f);
+		}
+	}
 };
 
